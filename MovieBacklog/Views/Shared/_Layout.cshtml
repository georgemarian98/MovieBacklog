<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>IMDB Movie Backlog</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="shortcut icon" href="~/logo.jpg" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom box-shadow header-fixed">
            <button class="btn" onclick="importLibrary()">Import library</button>
            <button class="btn" onclick="exportLibrary()">Export library</button>
            <div class="container">
                <a class="navbar-brand d-flex align-items-center" asp-area="" asp-action="Movies" asp-controller="Home">
                    <img src="~/logo.jpg" alt="logo" class="site-logo" />
                    <span class="brand-text">Movie Backlog</span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <!-- left: navigation links -->
                    <ul class="navbar-nav align-items-lg-center nav-left">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-action="Movies" asp-controller="Home">Movies</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-action="TvShows" asp-controller="Home">TV Shows</a>
                        </li>
                    </ul>

                    <!-- centered, constrained search -->
                    <div class="mx-auto navbar-search-wrapper">
                        <form asp-action="Search" class="navbar-search" role="search">
                            <div class="input-group input-group-sm">
                                <input class="form-control" type="search" id="mediaRecordTitle" name="mediaRecordTitle" placeholder="Search title..." aria-label="Search" />
                                <button class="btn btn-primary" type="submit">Search</button>
                            </div>
                        </form>
                    </div>

                    <!-- right: user select -->
                    <form asp-action="Users" class="d-flex ms-auto">
                        <select asp-items="ViewBag.ItemTypesSelectList" id="usersList" name="newUser" class="form-select form-select-sm navbar-user-select">
                        </select>
                    </form>
                </div>
            </div>
        </nav>
    </header>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/Index.js" type="text/javascript"></script>

    <!-- Mobile collapse JS fallback:
         toggles the `show` class on #mainNav and updates aria attributes when the native collapse isn't functioning. -->
    <script>
        (function () {
            var toggler = document.querySelector('.navbar-toggler');
            var target = document.getElementById('mainNav');
            if (!toggler || !target) return;

            toggler.addEventListener('click', function (e) {
                // Let Bootstrap handle it first if available; also toggle as fallback.
                var isShown = target.classList.toggle('show');
                toggler.classList.toggle('collapsed', !isShown);
                toggler.setAttribute('aria-expanded', isShown ? 'true' : 'false');
            });
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)

    <div class="container">
        <main role="main" class="pb-3 content-container">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2021 - MovieBacklog
        </div>
    </footer>
</body>
</html>

<style>
    .header-fixed {
        position: fixed;
        top: 0;
        width: 100%;
        z-index: 1;
    }

    .search-bar {
        padding-top: 5%;
    }

    .content-table {
        padding-top: 8rem;
    }
</style>