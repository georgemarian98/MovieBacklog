@model IEnumerable<MovieBacklog.Models.MediaRecord>
@{
    ViewData["Title"] = "TV Shows";
}

@section scripts {
    <script type="text/javascript" src="~/js/Index.js"></script>
}

<div class="mb-3">
    <h2 class="mb-0">TV Shows</h2>
    <small class="text-muted">Your backlog</small>
</div>

<div class="row">
    @foreach (var show in Model)
    {
        <div class="col-6 col-sm-6 col-md-4 col-lg-3 mb-4">
            <div class="card h-100">
                <img src="@show.ThumbnailUrl" alt="@show.Title" class="card-img-top" loading="lazy" decoding="async" onerror="updateThumbnail(this, @show.Id)" />
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title mb-1">@show.Title</h5>
                    <p class="card-text text-muted mb-2">
                        @show.Year
                        <span class="badge badge-tv ms-2">TV</span>
                    </p>
                    <div class="controls mt-auto">
                        <a href="@show.ImdbUrl" class="btn btn-sm btn-outline-primary" target="_blank" rel="noopener">IMDB</a>
                        <button class="btn btn-sm btn-danger" onclick="deleteMediaRecord(@show.Id)">Remove</button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
